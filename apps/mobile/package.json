    "@swissov/types": "workspace:*",
    "@swissov/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~52.0.23",
    "expo-application": "~6.0.1",
    "expo-constants": "~17.0.3",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.3",
    "expo-location": "~18.0.4",
    "expo-notifications": "~0.29.11",
