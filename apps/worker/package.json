{
  "name": "@swissov/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration.test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "push:keys": "tsx src/scripts/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@swissov/config": "workspace:*",
    "@swissov/database": "workspace:*",
    "@swissov/shared": "workspace:*",
    "@swissov/transit": "workspace:*",
    "@swissov/types": "workspace:*",
    "croner": "^9.0.0",
    "zod": "^3.24.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/web-push": "^3.6.4"
  }
}
