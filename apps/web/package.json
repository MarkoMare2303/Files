{
  "name": "@swissov/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3002}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3002}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --ext .ts,.tsx",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "clean": "rm -rf .next .turbo dist test-results playwright-report",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@swissov/shared": "workspace:*",
    "@swissov/types": "workspace:*",
    "@swissov/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "idb": "^8.0.1",
    "maplibre-gl": "^4.7.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
