###############################################################################
# Schweizer ÖV Live — Beispiel-Konfiguration
#
# Kopieren nach `.env` und ausfüllen:   cp .env.example .env
# NIEMALS echte Secrets committen. `.env` ist in .gitignore.
#
# Legende:
#   [erforderlich]  Ohne diesen Wert startet der Dienst nicht.
#   [optional]      Feature wird deaktiviert bzw. Fallback greift.
#   [extern]        Muss bei einem externen Anbieter beantragt werden.
###############################################################################

# --- Laufzeit -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Datenbank ----------------------------------------------------------------
# [erforderlich] PostgreSQL 15+ mit PostGIS 3.3+
DATABASE_URL=postgresql://swissov:swissov@localhost:5432/swissov_dev
# [optional] Separate DB für Integrationstests (sonst wird DATABASE_URL genutzt)
TEST_DATABASE_URL=postgresql://swissov:swissov@localhost:5432/swissov_test
# [optional] Pool-Grösse des API-Servers
DATABASE_POOL_MAX=10

# --- Supabase -----------------------------------------------------------------
# [extern] https://supabase.com → Project Settings → API
# Ohne diese Werte laufen API/Worker weiter, aber Auth-Token-Prüfung
# (asymmetrisch), Realtime-Broadcast und Account-Löschung sind deaktiviert.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# [extern] NUR serverseitig verwenden — niemals in Mobile/Admin-Client bundlen.
SUPABASE_SERVICE_ROLE_KEY=
# [extern] Project Settings → API → JWT Settings → JWT Secret (HS256-Verifikation)
SUPABASE_JWT_SECRET=

# --- Schweizer ÖV-Daten (opentransportdata.swiss) -----------------------------
# [extern] Kostenloses Konto: https://opentransportdata.swiss/de/register/
#          Danach unter "Meine Konten" → API-Token erzeugen.
# Wird für GTFS-RT (Trip Updates) und Service Alerts benötigt.
OPENTRANSPORTDATA_API_KEY=

# [optional] GTFS-Static-Quelle. Der Permalink zeigt immer auf den aktuellen
# Schweizer Gesamtdatensatz (Fahrplan des laufenden Jahres).
GTFS_STATIC_URL=https://opentransportdata.swiss/dataset/timetable-2025-gtfs2020/permalink
# [optional] GTFS-RT Trip-Updates-Endpunkt (Protocol Buffers)
GTFS_RT_TRIP_UPDATES_URL=https://api.opentransportdata.swiss/gtfsrt2020
# [optional] GTFS-RT Service-Alerts-Endpunkt (Protocol Buffers)
GTFS_RT_SERVICE_ALERTS_URL=https://api.opentransportdata.swiss/gtfsrt2020
# [optional] Polling-Intervalle in Sekunden (Provider-Rate-Limits beachten!)
GTFS_RT_POLL_INTERVAL_SECONDS=30
SERVICE_ALERTS_POLL_INTERVAL_SECONDS=120

# --- OJP (Open Journey Planner) ----------------------------------------------
# [extern] Separater API-Key von opentransportdata.swiss für den OJP-Endpunkt.
OJP_API_KEY=
OJP_ENDPOINT_URL=https://api.opentransportdata.swiss/ojp20
OJP_REQUESTOR_REF=swissov-live

# --- Cache --------------------------------------------------------------------
# [optional] Ohne REDIS_URL wird ein prozesslokaler LRU-Cache verwendet.
#            Für Produktion (mehrere Instanzen) dringend empfohlen.
REDIS_URL=

# --- API-Server ---------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# Komma-separierte Liste erlaubter Origins für CORS (Admin-Portal, Web-Preview).
API_CORS_ORIGINS=http://localhost:3000
# [erforderlich in Produktion] Zufälliger 32+ Zeichen langer Wert; signiert
# interne Tokens (z. B. Datenexport-Links).
API_INTERNAL_SECRET=change-me-in-production-min-32-characters
# Öffentliche Basis-URL der API (für OpenAPI-Server-Eintrag)
API_PUBLIC_URL=http://localhost:3001

# --- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=240
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_VOTES_PER_HOUR=120

# --- Push Notifications -------------------------------------------------------
# [optional] Expo Access Token erhöht die Rate Limits des Push-Service.
#            https://expo.dev → Account Settings → Access Tokens
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true

# --- Karten -------------------------------------------------------------------
# [optional/extern] MapLibre-kompatible Style-URL. Ohne Key wird der freie
# demotiles-Style verwendet (nur für Entwicklung geeignet).
# Empfehlung für CH: https://www.swisstopo.admin.ch (Vector Tiles, frei) oder
# MapTiler (API-Key erforderlich).
MAP_TILE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap.vt/style.json

# --- Admin-Portal (Next.js) ---------------------------------------------------
ADMIN_PORT=3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
# Session-Timeout des Admin-Portals in Minuten
ADMIN_SESSION_TIMEOUT_MINUTES=30

# --- Mobile (Expo) — nur nicht-geheime Werte! ---------------------------------
# Alles mit EXPO_PUBLIC_ landet im App-Bundle und ist damit öffentlich.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAP_TILE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap.vt/style.json

# --- OAuth --------------------------------------------------------------------
# [extern] Apple Developer Program (99 USD/Jahr) → Sign in with Apple
APPLE_CLIENT_ID=
# [extern] Google Cloud Console → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Observability ------------------------------------------------------------
# [optional] Sentry DSN; ohne Wert wird ein No-Op-Adapter verwendet.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
