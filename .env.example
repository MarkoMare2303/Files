###############################################################################
# Schweizer ÖV Live — Beispiel-Konfiguration
#
# Kopieren nach `.env` und ausfüllen:   cp .env.example .env
# NIEMALS echte Secrets committen. `.env` ist in .gitignore.
#
# Legende:
#   [erforderlich]  Ohne diesen Wert startet der Dienst nicht.
#   [optional]      Feature wird deaktiviert bzw. Fallback greift.
#   [extern]        Muss bei einem externen Anbieter beantragt werden.
###############################################################################

# --- Laufzeit -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Datenbank ----------------------------------------------------------------
# [erforderlich] PostgreSQL 15+ mit PostGIS 3.3+
DATABASE_URL=postgresql://swissov:swissov@localhost:5432/swissov_dev
# [optional] Separate DB für Integrationstests (sonst wird DATABASE_URL genutzt)
TEST_DATABASE_URL=postgresql://swissov:swissov@localhost:5432/swissov_test
# [optional] Pool-Grösse des API-Servers
DATABASE_POOL_MAX=10

# --- Supabase -----------------------------------------------------------------
# [extern] https://supabase.com → Project Settings → API
# Ohne diese Werte laufen API/Worker weiter, aber Auth-Token-Prüfung
# (asymmetrisch), Realtime-Broadcast und Account-Löschung sind deaktiviert.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# [extern] NUR serverseitig verwenden — niemals in Mobile/Admin-Client bundlen.
SUPABASE_SERVICE_ROLE_KEY=
# [extern] Project Settings → API → JWT Settings → JWT Secret (HS256-Verifikation)
SUPABASE_JWT_SECRET=

# --- Schweizer ÖV-Daten (opentransportdata.swiss) -----------------------------
# [extern] Kostenloses Konto: https://opentransportdata.swiss/de/register/
#
# WICHTIG: Das Portal vergibt KEINEN Schlüssel für alles. Pro Dienst wird eine
# eigene Anwendung registriert — jede mit eigener App-ID und eigenem Token.
# Ein Token am falschen Endpunkt antwortet mit 401/403 und sieht dabei aus wie
# ein abgelaufener Schlüssel, ist aber nur der falsche.
#
# Diese drei braucht die App:
#
#   CKAN     Download des Fahrplans (GTFS-Static)      → erforderlich
#   GTFS-RT  Verspätungen und Ausfälle                 → für Echtzeitdaten
#   GTFS-SA  offizielle Störungsmeldungen              → für offizielle Meldungen
#
# Nicht verwendet werden SIRI-PT (siri_pt_plan) und SIRI-ET (siri_et_plan) —
# die App liest dieselben Informationen aus den GTFS-Feeds.
OPENTRANSPORTDATA_CKAN_API_KEY=
OPENTRANSPORTDATA_GTFS_RT_API_KEY=
OPENTRANSPORTDATA_GTFS_SA_API_KEY=

# [optional] Rückfall für alle drei Dienste. Greift nur dort, wo oben nichts
# steht — gedacht für Installationen aus der Zeit vor der Aufteilung und für
# den Fall, dass ein Token wirklich mehrere Dienste abdeckt.
OPENTRANSPORTDATA_API_KEY=

# [optional] Authentifizierungsverfahren gegenüber opentransportdata.swiss.
# Leer lassen: bei 401/403 werden bearer → raw → header automatisch
# durchprobiert. Wer das richtige Verfahren kennt, spart die Fallback-Anfragen.
#   bearer   Authorization: Bearer <key>   (Standard)
#   raw      Authorization: <key>          (ältere GTFS-RT-Endpunkte)
#   header   Authorization + apikey        (manche Gateways)
OPENTRANSPORTDATA_AUTH_SCHEME=

# [optional] GTFS-Static-Quelle. Der Permalink zeigt immer auf den aktuellen
# Schweizer Gesamtdatensatz (Fahrplan des laufenden Jahres).
GTFS_STATIC_URL=https://opentransportdata.swiss/dataset/timetable-2025-gtfs2020/permalink
# [optional] GTFS-RT Trip-Updates-Endpunkt (Protocol Buffers)
GTFS_RT_TRIP_UPDATES_URL=https://api.opentransportdata.swiss/gtfsrt2020
# [optional] GTFS-RT Service-Alerts-Endpunkt (Protocol Buffers)
GTFS_RT_SERVICE_ALERTS_URL=https://api.opentransportdata.swiss/gtfsrt2020
# [optional] Polling-Intervalle in Sekunden (Provider-Rate-Limits beachten!)
GTFS_RT_POLL_INTERVAL_SECONDS=30
SERVICE_ALERTS_POLL_INTERVAL_SECONDS=120

# --- OJP 2.0 (Open Journey Planner) — optional --------------------------------
# [extern] Eigene Anwendung im Portal, eigenes Token. Hier greift KEIN Rückfall
# auf OPENTRANSPORTDATA_API_KEY: OJP ist optional, und ein stillschweigend
# falscher Schlüssel liesse die Verbindungssuche „konfiguriert, aber kaputt"
# erscheinen statt schlicht „nicht aktiv".
#
# Ohne OJP sucht die App direkt auf den importierten Fahrplandaten:
# Direktverbindungen und einfache Umstiege ja, optimierte Reiseketten nein.
OJP_API_KEY=
OJP_ENDPOINT_URL=https://api.opentransportdata.swiss/ojp20
OJP_REQUESTOR_REF=swissov-live

# --- Cache --------------------------------------------------------------------
# [optional] Ohne REDIS_URL wird ein prozesslokaler LRU-Cache verwendet.
#            Für Produktion (mehrere Instanzen) dringend empfohlen.
REDIS_URL=

# --- API-Server ---------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# Komma-separierte Liste erlaubter Origins für CORS (Admin-Portal, Web-Preview).
# [erforderlich in Produktion] Erlaubte Browser-Origins, kommagetrennt.
#
# Seit die App eine PWA ist, ist der Browser ein CORS-Client. Fehlt die eigene
# Domain hier, antwortet die API zwar mit 200, der Browser verwirft die Antwort
# aber — die App bleibt leer, ohne sichtbaren Fehler in den Serverlogs.
# In Produktion ausschliesslich die echte Domain eintragen:
#   API_CORS_ORIGINS=https://app.example.ch
# Ausserhalb der Produktion sind diese lokalen Ports auch ohne Eintrag erlaubt.
API_CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3102,http://127.0.0.1:3102
# [erforderlich in Produktion] Zufälliger 32+ Zeichen langer Wert; signiert
# interne Tokens (z. B. Datenexport-Links).
API_INTERNAL_SECRET=change-me-in-production-min-32-characters
# Öffentliche Basis-URL der API (für OpenAPI-Server-Eintrag)
API_PUBLIC_URL=http://localhost:3001

# --- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=240
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_VOTES_PER_HOUR=120

# --- Push Notifications (Web Push / VAPID) ------------------------------------
# [erforderlich für Push] Schlüsselpaar erzeugen mit:
#
#     pnpm push:keys
#
# Der ÖFFENTLICHE Schlüssel wird über GET /v1/app-config an den Browser
# ausgeliefert — das ist vorgesehen und unbedenklich.
# Der PRIVATE Schlüssel gehört ausschliesslich in die Serverumgebung des
# Workers. Er darf NIE in einer NEXT_PUBLIC_*-Variable stehen, nie in ein
# Bundle geraten und nie in ein Log.
#
# Achtung: Wird das Paar gewechselt, verlieren ALLE bestehenden Abos ihre
# Gültigkeit — Browser melden sich mit dem alten Schlüssel an und der
# Push-Dienst antwortet mit HTTP 403.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# mailto:- oder https:-Adresse; Push-Dienste verlangen einen Kontakt.
WEB_PUSH_SUBJECT=mailto:push@example.ch
PUSH_ENABLED=true
# Wie oft der Worker die Push-Warteschlange abarbeitet (Sekunden).
PUSH_JOB_INTERVAL_SECONDS=20

# [veraltet] Nur für Altbestände der nativen App relevant. Die PWA nutzt
# ausschliesslich Web Push.
EXPO_ACCESS_TOKEN=

# --- Karten -------------------------------------------------------------------
# [optional/extern] MapLibre-kompatible Style-URL. Ohne Key wird der freie
# demotiles-Style verwendet (nur für Entwicklung geeignet).
# Empfehlung für CH: https://www.swisstopo.admin.ch (Vector Tiles, frei) oder
# MapTiler (API-Key erforderlich).
MAP_TILE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap.vt/style.json

# --- Admin-Portal (Next.js) ---------------------------------------------------
ADMIN_PORT=3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
# Session-Timeout des Admin-Portals in Minuten
ADMIN_SESSION_TIMEOUT_MINUTES=30

# --- Web-App (PWA) — nur nicht-geheime Werte! ---------------------------------
# Alles mit NEXT_PUBLIC_ wird zur Bauzeit ins JavaScript eingesetzt und ist im
# Browser lesbar. Hier gehören ausschliesslich öffentliche Werte hinein.
WEB_PORT=3002
NEXT_PUBLIC_MAP_TILE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap.vt/style.json
# Wird in der Geräteregistrierung mitgesendet; hilft beim Einordnen von Fehlern.
NEXT_PUBLIC_APP_VERSION=0.1.0
# Port, unter dem die E2E-Tests die gebaute App starten.
WEB_E2E_PORT=3102

# --- Mobile (Expo) — eingefroren ----------------------------------------------
# Die native App wird derzeit NICHT veröffentlicht (siehe
# MOBILE_TO_WEB_MIGRATION.md). Die Variablen bleiben, solange apps/mobile im
# Repository liegt. Alles mit EXPO_PUBLIC_ landet im App-Bundle.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAP_TILE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap.vt/style.json

# --- OAuth --------------------------------------------------------------------
# [extern] Apple Developer Program (99 USD/Jahr) → Sign in with Apple
APPLE_CLIENT_ID=
# [extern] Google Cloud Console → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Observability ------------------------------------------------------------
# [optional] Sentry DSN; ohne Wert wird ein No-Op-Adapter verwendet.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
