{
  "name": "swissov-live",
  "version": "0.1.0",
  "private": true,
  "description": "Schweizer ÖV Live Community App — Monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter @swissov/database run migrate",
    "db:migrate:status": "pnpm --filter @swissov/database run migrate:status",
    "db:seed": "pnpm --filter @swissov/database run seed",
    "db:reset": "pnpm --filter @swissov/database run reset",
    "gtfs:import": "pnpm --filter @swissov/transit run import",
    "api:dev": "pnpm --filter @swissov/api run dev",
    "worker:dev": "pnpm --filter @swissov/worker run dev",
    "admin:dev": "pnpm --filter @swissov/admin run dev",
    "mobile:dev": "pnpm --filter @swissov/mobile run start",
    "web:dev": "pnpm --filter @swissov/web run dev",
    "push:keys": "pnpm --filter @swissov/worker run push:keys",
    "test:e2e": "pnpm --filter @swissov/web run test:e2e",
    "gtfs:verify-production": "pnpm --filter @swissov/transit run verify:production",
    "gtfs:verify-realtime": "pnpm --filter @swissov/transit run verify:realtime",
    "deploy:bundle": "node scripts/build-deploy-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "protobufjs",
      "@swc/core",
      "unrs-resolver",
      "core-js"
    ]
  }
}
